# Defaults for every environment. Override locally in .env.local (not committed).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8090
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://maker:maker@127.0.0.1:5433/maker?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> template maker ###
# Encrypts designers' API keys. Set a long random value and never change it (stored keys become unreadable).
MAKER_ENCRYPTION_KEY=
GOTENBERG_URL=http://127.0.0.1:3000
# Open sign-up (1) or only accounts created with app:create-user (0)
MAKER_OPEN_REGISTRATION=1
###< template maker ###
