# Defaults for docker compose. Override in .env.docker (copy .env.example).
APP_ENV=prod
APP_SECRET=change_me_to_a_random_32_char_hex
DEFAULT_URI=http://localhost:8090
POSTGRES_DB=maker
POSTGRES_USER=maker
POSTGRES_PASSWORD=maker
DATABASE_URL=postgresql://maker:maker@database:5432/maker?serverVersion=16&charset=utf8
MESSENGER_TRANSPORT_DSN=sync://
MAILER_DSN=null://null
GOTENBERG_URL=http://gotenberg:3000
# Encrypts designers' API keys: set a long random value and keep it forever
MAKER_ENCRYPTION_KEY=
MAKER_OPEN_REGISTRATION=1
# First designer account (created when missing)
MAKER_ADMIN_EMAIL=designer@cvolve.local
MAKER_ADMIN_PASSWORD=designer1234
